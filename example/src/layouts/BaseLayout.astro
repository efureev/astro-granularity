---
import pkg from '@feugene/granularity/package.json'
import ThemeToggle from '@feugene/astro-granularity/components/ThemeToggle.astro'
import SiteFooter from '../components/SiteFooter.vue'
import SiteHeader from '../components/SiteHeader.vue'
import { alternates, localePath, type PageKey } from '../i18n/routing'
import { defaultLocale, localeNames, type Locale, locales, strings } from '../i18n/ui'
import '../styles/theme.css'

interface Props {
  locale: Locale
  page: PageKey
  title: string
  description: string
  /**
   * Страница вне навигации: 404. Ни один пункт меню не помечается текущим, а
   * сама страница закрывается от индексации — canonical на обзор увёл бы
   * поисковик не туда.
   */
  offRoute?: boolean
}

const { locale, page, title, description, offRoute = false } = Astro.props
const t = strings(locale)

const canonical = new URL(localePath(locale, page), Astro.site).href
const alts = alternates(page).map(a => ({ ...a, href: new URL(a.path, Astro.site).href }))
const xDefault = new URL(localePath(defaultLocale, 'index'), Astro.site).href

const nav = ([
  { key: 'index', label: t.navOverview },
  { key: 'settings', label: t.navSettings },
] as const).map(item => ({
  label: item.label,
  href: localePath(locale, item.key),
  current: !offRoute && item.key === page,
}))

// Переключатель языка ведёт на **эту же** страницу в другом языке, а не на
// главную: иначе выбор языка терял бы место, где человек находится.
const localeLinks = locales.map(code => ({
  value: code,
  label: localeNames[code],
  href: localePath(code, page),
}))
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {offRoute
      ? <meta name="robots" content="noindex, follow" />
      : (
          <>
            <link rel="canonical" href={canonical} />
            {alts.map(alt => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
            <link rel="alternate" hreflang="x-default" href={xDefault} />
          </>
        )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a class="skip-link rounded-[var(--gr-radius-md)] bg-[var(--gr-primary)] px-4 py-2 text-sm text-[var(--gr-primary-fg)]" href="#content">
      {t.skipToContent}
    </a>

    <SiteHeader
      client:load
      siteName={t.siteName}
      navLabel={t.navLabel}
      nav={nav}
      localeLabel={t.langLabel}
      localeLinks={localeLinks}
      currentLocale={locale}
    >
      <ThemeToggle
        slot="theme"
        class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--gr-radius-md)] border border-[var(--gr-brd)] bg-[var(--gr-card)] text-[var(--gr-fg)] transition-colors hover:bg-[var(--gr-muted)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gr-ring)]"
        labelLight={t.themeToLight}
        labelDark={t.themeToDark}
      >
        <svg class="theme-icon-light h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="theme-icon-dark h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </ThemeToggle>
    </SiteHeader>

    <main id="content" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 lg:px-8 lg:py-12">
      <slot />
    </main>

    <SiteFooter
      client:load
      note={t.footerNote}
      version={pkg.version}
      versionHint={t.versionHint}
      backToTop={t.backToTop}
    />
  </body>
</html>
