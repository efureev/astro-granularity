---
import SettingsPage from '../../components/SettingsPage.astro'
import { defaultLocale, type Locale, locales } from '../../i18n/ui'

export function getStaticPaths() {
  return locales
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({ params: { lang: locale } }))
}

const locale = Astro.params.lang as Locale
---

<SettingsPage locale={locale} />
