---
import OverviewPage from '../../components/OverviewPage.astro'
import { defaultLocale, type Locale, locales } from '../../i18n/ui'

/**
 * Языки, кроме основного: он живёт без префикса (`prefixDefaultLocale: false`)
 * и отдаётся `src/pages/index.astro`.
 */
export function getStaticPaths() {
  return locales
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({ params: { lang: locale } }))
}

const locale = Astro.params.lang as Locale
---

<OverviewPage locale={locale} />
