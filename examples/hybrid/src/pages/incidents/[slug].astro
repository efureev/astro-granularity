---
// Единственные маршруты стенда, уходящие в рантайм: списки остаются
// статикой, карточка собирается на запрос.
export const prerender = false

import IncidentPage from '@shared/components/IncidentPage.astro'
import { incidentBySlug } from '@shared/data/incidents'
import { defaultLocale } from '@shared/i18n/ui'

const entry = await incidentBySlug(defaultLocale, Astro.params.slug)
if (!entry)
  return new Response(null, { status: 404 })
---

<IncidentPage locale={defaultLocale} entry={entry} />
