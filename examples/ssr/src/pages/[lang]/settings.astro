---
import SettingsPage from '@shared/components/SettingsPage.astro'
import { defaultLocale, type Locale, locales } from '@shared/i18n/ui'

const locale = Astro.params.lang as Locale
if (!locales.includes(locale) || locale === defaultLocale)
  return new Response(null, { status: 404 })
---

<SettingsPage locale={locale} />
