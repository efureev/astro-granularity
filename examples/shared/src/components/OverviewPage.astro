---
import { incidentsFor } from '../data/incidents'
import { environments, services } from '../data/services'
import { incidentPath } from '../i18n/routing'
import { strings, type Locale } from '../i18n/ui'
import BaseLayout from '../layouts/BaseLayout.astro'
import LastChecked from './LastChecked.vue'
import ServiceBoard from './ServiceBoard.vue'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = strings(locale)

// Свежий отчёт на каждый сервис: диалог с деталями ведёт на разбор, а не
// заканчивается датой. Список отсортирован по убыванию даты, поэтому первый
// найденный и есть последний.
const reports = await incidentsFor(locale)
const incidentHrefs = Object.fromEntries(
  services.map(service => [
    service.id,
    reports.find(({ entry }) => entry.data.service === service.id)?.slug,
  ]).filter((pair): pair is [string, string] => Boolean(pair[1]))
    .map(([id, slug]) => [id, incidentPath(locale, slug)]),
)
---

<BaseLayout
  locale={locale}
  page="index"
  title={`${t.overviewTitle} — ${t.siteName}`}
  description={t.overviewDescription}
>
  <header class="mb-8 grid gap-2">
    <h1 class="m-0 text-3xl font-semibold tracking-tight text-[var(--gr-fg)] lg:text-4xl">
      {t.overviewTitle}
    </h1>
    <p class="m-0 max-w-2xl text-[var(--gr-muted-fg)]">{t.overviewDescription}</p>
    <!--
      Место под остров резервируется здесь, а не внутри компонента: `client:only`
      на сервере не рендерит ничего, и до монтирования самого элемента с его
      `min-height` попросту нет — резервировать было бы нечему. Высота равна
      строке `text-sm`.
    -->
    <div class="min-h-5">
      <LastChecked client:only="vue" label={t.lastCheckedLabel} locale={locale} />
    </div>
  </header>

  <ServiceBoard
    client:load
    t={t}
    locale={locale}
    services={[...services]}
    environments={[...environments]}
    incidentHrefs={incidentHrefs}
    incidentReadLabel={t.incidentRead}
    initialEnv="prod"
  />
</BaseLayout>
