---
import { incidentsFor } from '../data/incidents'
import { incidentPath } from '../i18n/routing'
import { strings, type Locale } from '../i18n/ui'
import BaseLayout from '../layouts/BaseLayout.astro'
import IncidentsBoard from './IncidentsBoard.vue'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = strings(locale)
// Датам нужен ISO: острову пропсы приезжают сериализованными, и `Date`
// пережил бы сериализацию, но в шаблоне удобнее одна форма на оба конца.
const items = (await incidentsFor(locale)).map(({ entry, slug }) => ({
  slug,
  href: incidentPath(locale, slug),
  title: entry.data.title,
  summary: entry.data.summary,
  date: entry.data.date.toISOString(),
  service: entry.data.service,
  severity: entry.data.severity,
  resolved: entry.data.resolved,
}))
---

<BaseLayout
  locale={locale}
  page="incidents"
  title={`${t.incidentsTitle} — ${t.siteName}`}
  description={t.incidentsDescription}
>
  <header class="mb-8 grid gap-2">
    <h1 class="m-0 text-3xl font-semibold tracking-tight text-[var(--gr-fg)] lg:text-4xl">
      {t.incidentsTitle}
    </h1>
    <p class="m-0 max-w-2xl text-[var(--gr-muted-fg)]">{t.incidentsDescription}</p>
  </header>

  <IncidentsBoard client:load t={t} locale={locale} items={items} />

</BaseLayout>
