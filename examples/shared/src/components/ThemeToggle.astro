---
/**
 * Переключатель режима без Vue.
 *
 * Тянуть остров ради одной кнопки бессмысленно: вся работа — узнать режим по
 * паре на `<html>`, включить режим другой схемы и сохранить выбор. Это делает
 * контроллер granum по манифесту сборки — пары руками не пишутся. Скрипт Astro
 * поднимает один на страницу независимо от числа кнопок. Куда сохранять выбор —
 * ключ `themeStorageKey` или cookie `themeCookie`, — говорит интеграция.
 */
interface Props {
  class?: string
  /** Доступное имя, когда нажатие включит светлый режим. */
  labelLight?: string
  /** Доступное имя, когда нажатие включит тёмный. */
  labelDark?: string
}

const {
  class: className,
  labelLight = 'Switch to light theme',
  labelDark = 'Switch to dark theme',
} = Astro.props
---

<button
  type="button"
  class={className}
  data-gr-theme-toggle
  data-label-light={labelLight}
  data-label-dark={labelDark}
>
  <slot />
</button>

<script>
  import { createCookieStorage, createThemeController } from '@feugene/granum/runtime'
  import manifest from 'virtual:granum/themes'
  import { cookie, storageKey } from 'virtual:granularity/theme'

  const SELECTOR = '[data-gr-theme-toggle]'

  /**
   * Режим другой схемы и контроллер, который его включит. Контроллер — на
   * каждое обращение, а не один на модуль: `ClientRouter` подменяет документ,
   * не переисполняя модуль, а свежий контроллер узнаёт режим по паре на корне.
   */
  function nextMode() {
    const controller = createThemeController(manifest, cookie ? { storage: createCookieStorage({ name: cookie }) } : { storageKey })
    const scheme = controller.modes().find(mode => mode.name === controller.mode)?.colorScheme
    return { controller, next: controller.modes().find(mode => mode.colorScheme !== scheme) }
  }

  /**
   * Имя кнопки описывает результат нажатия, а не текущее состояние: «Switch to
   * dark theme» на светлой странице. `aria-pressed` здесь только запутал бы —
   * непонятно, что считать нажатым.
   */
  function syncLabels() {
    for (const el of document.querySelectorAll<HTMLElement>(SELECTOR)) {
      const { next } = nextMode()
      const label = next?.colorScheme === 'dark' ? el.dataset.labelDark : el.dataset.labelLight
      if (label)
        el.setAttribute('aria-label', label)
    }
  }

  // Делегирование, а не слушатель на кнопку: кнопки могут приехать позже —
  // из острова, из перехода `ClientRouter`, из вставленного фрагмента.
  document.addEventListener('click', (event) => {
    const target = (event.target as Element | null)?.closest<HTMLElement>(SELECTOR)
    if (!target)
      return
    // Запись выбора бросает в приватном режиме Safari — контроллер это ловит:
    // режим переключится, просто не переживёт перезагрузку.
    const { controller, next } = nextMode()
    if (next)
      controller.setMode(next.name)
    syncLabels()
  })

  syncLabels()
  document.addEventListener('astro:after-swap', syncLabels)
</script>
